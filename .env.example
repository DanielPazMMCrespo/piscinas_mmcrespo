APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily  # Usar 'daily' em produção (rotação automática); 'single' só para dev local
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning  # NUNCA 'debug' em produção — expõe queries SQL e stack traces nos logs
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Produção (Railway): usar 'redis' (plugin Redis) — tira sessão/cache de cima do PostgreSQL.
# Fallback dev local sem Redis: 'database'.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true  # Cifra o payload da sessão na BD — manter true em produção
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies de sessao: secure exige HTTPS. Em dev local sobre http://localhost, definir SESSION_SECURE_COOKIE=false.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Filas (queues) ───────────────────────────────────────────────────────────
# Produção (Railway): driver 'database' sobre PostgreSQL. Um serviço worker
# dedicado corre `php artisan queue:work` (ver docker-entrypoint.sh modo worker).
QUEUE_CONNECTION=database
# Conexão de BD usada pela fila (tabela jobs). Em Railway: 'pgsql'.
DB_QUEUE_CONNECTION=pgsql
DB_QUEUE_TABLE=jobs
# Filas processadas, por ordem de prioridade. ProcessDailyRecordAfterCreate usa 'daily-records'.
DB_QUEUE=daily-records,default
# Segundos antes de um job reservado ser reentregue — DEVE ser > job timeout (60s).
DB_QUEUE_RETRY_AFTER=120
DB_QUEUE_AFTER_COMMIT=true
# Falhas guardadas com UUID (tabela failed_jobs tem coluna uuid).
QUEUE_FAILED_DRIVER=database-uuids

# Produção (Railway): 'redis'. Fallback dev local sem Redis: 'database'.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Em Railway: usar o host PRIVADO do plugin Redis (ex: <nome>.railway.internal), nunca o público.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IA — Google Gemini (OCR de fotos de filtros e folhas de análise)
GEMINI_API_KEY=
# Modelo OCR: gemini-2.0-flash (padrão, melhor OCR) | gemini-1.5-pro (mais lento, mais preciso em casos difíceis)
GEMINI_OCR_MODEL=gemini-2.0-flash

# Sensores Hanna Cloud (BL132) — credenciais da conta cloud.hannainst.com
# OBRIGATÓRIO definir em Railway — nunca colocar a password real aqui
HANNA_CLOUD_EMAIL=
HANNA_CLOUD_PASSWORD=

# Versão da aplicação — definir no CI/CD: APP_VERSION=$(git rev-parse --short HEAD)
APP_VERSION=unknown

# Password padrão de primeiro acesso — definir no .env real (NUNCA aqui)
# Usada pelo PasswordChangeController para bloquear reutilização da password padrão
DEFAULT_USER_PASSWORD=

# Admin passwords iniciais — OBRIGATÓRIO em produção ou o seeder usa fallback fraco
ADMIN_PASSWORD_DANIEL=
ADMIN_PASSWORD_MARCIO=

# IPs autorizados a aceder ao endpoint /api/health (separados por vírgula)
HEALTH_CHECK_IPS=127.0.0.1

# Sentry — monitoring e logging em produção
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_CLIENT_REPORTS=true
