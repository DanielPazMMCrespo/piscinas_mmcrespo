# 🚀 PRODUCTION ENVIRONMENT — Railway/Leiria

# APP SETTINGS
APP_NAME=Piscinas\ MMCrespo
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seu-dominio-production.com
APP_KEY=base64:YOUR_GENERATED_KEY_HERE
APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en

# DATABASE — PostgreSQL via Railway
DB_CONNECTION=pgsql
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_DATABASE=${DB_DATABASE}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# SESSION
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# QUEUE & CACHE
QUEUE_CONNECTION=database
CACHE_STORE=database

# FILESYSTEM
FILESYSTEM_DISK=local

# LOG
LOG_CHANNEL=stack
LOG_LEVEL=warning

# MAIL (usar Mailgun, SendGrid, ou similar em produção)
MAIL_MAILER=log
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=YOUR_EMAIL
MAIL_PASSWORD=YOUR_PASSWORD
MAIL_FROM_ADDRESS="no-reply@mmcrespo.pt"
MAIL_FROM_NAME="Piscinas MMCrespo"

# BROADCAST
BROADCAST_CONNECTION=log

# REDIS (opcional, para cache + queue)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# HANNA CLOUD (Sensores)
HANNA_CLOUD_EMAIL=your-hanna-email@mmcrespo.pt
HANNA_CLOUD_PASSWORD=YOUR_HANNA_PASSWORD

# GOOGLE GEMINI (se usar AI — atualmente desativado)
GEMINI_API_KEY=your-gemini-key-here

# VITE
VITE_APP_NAME="Piscinas MMCrespo"
