# Dependencies (reinstalled inside the image)
node_modules
vendor

# Local environment & secrets (Railway injects real env vars)
.env
.env.*
!.env.example

# Version control & tooling
.git
.gitignore
.claude
.github
.idea
.vscode

# Local build artifacts / caches
public/build
public/hot
public/storage
storage/logs/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Local DB & misc
database/*.sqlite
database/*.sqlite-journal
*.zip
*.log
npm-debug.log
yarn-error.log
tests
phpunit.xml
README.md
MASTER_ROADMAP.md
